{
  "name": "sourcecode",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build:playlist": "node ./scripts/build-playlist.mjs",
    "prebuild": "npm run build:playlist",
    "pretest": "npm run build:playlist",
    "dev": "vite",
    "build": "vite build",
    "test": "node --test",
    "preview": "vite preview",
    "sync:root": "node ./scripts/deploy.mjs",
    "sync:remote": "node ./scripts/deploy-remote.mjs",
    "deploy": "npm run build && npm run sync:root",
    "deploy:remote": "npm run deploy && npm run sync:remote",
    "deploy:quick": "npm run deploy && node ./scripts/deploy-remote.mjs --quick",
    "serve:root": "node ./scripts/local-server.mjs -r .. -H 127.0.0.1 -p 5500",
    "deploy:serve": "npm run deploy && npm run serve:root"
  },
  "dependencies": {
    "music-metadata": "^12.3.3",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "vite": "^8.3.5"
  }
}
